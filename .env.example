# Connection string do banco Neon (Postgres).
# No painel da Neon: Dashboard > seu projeto > Connection Details > "Pooled connection".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# String aleatória longa usada para assinar a sessão do painel admin.
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=

# Credenciais de login da Isabella no painel admin (/admin).
ADMIN_EMAIL=isabella@exemplo.com
# Gere o hash com: npm run hash-password -- "a-senha-escolhida"
# IMPORTANTE: o comando acima já imprime o valor pronto para colar aqui,
# com os `$` escapados como `\$`. O hash bcrypt é cheio de `$` (ex: $2a$12$...),
# e o carregador de .env do Next.js trata `$` como início de variável — colar
# o hash sem escapar corrompe o valor silenciosamente e quebra o login.
ADMIN_PASSWORD_HASH=

# Opcional: token do Vercel Blob, para permitir upload de imagem de capa
# direto do computador no painel admin (sem precisar colar uma URL).
# Criado automaticamente ao conectar um "Blob Store" ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN=
